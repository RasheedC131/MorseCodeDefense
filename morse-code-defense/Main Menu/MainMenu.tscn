[sub_resource type="GDScript" id="GDScript_iwfq2"]
script/source = "extends TextureRect

@export var amplitude := 6.0   # how many pixels it moves up/down
@export var duration := 2    # seconds for each half of the bob

func _ready():
	var start_y := position.y
	var tween := create_tween().set_loops()
	tween.tween_property(self, \"position:y\", start_y - amplitude, duration)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(self, \"position:y\", start_y + amplitude, duration)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
"

