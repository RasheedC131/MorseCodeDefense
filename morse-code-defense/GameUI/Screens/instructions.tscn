[node name="Story" type="RichTextLabel" parent="Panel/Box" unique_id=1326463748]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 17
bbcode_enabled = true
text = "[center][color=#f2c25a]TK[/color] is sending out an [color=#f2c25a]SOS[/color] in Morse code! Creatures are creeping through the forest toward Lenny. Answer the call and help [color=#f2c25a]Lenny survive[/color]![/center]"
fit_content = true
scroll_active = false

[node name="Rules" type="RichTextLabel" parent="Panel/Box" unique_id=1301059804]
layout_mode = 2
mouse_filter = 2
theme_override_constants/paragraph_separation = 2
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "[ol type=1] Every creature carries a [color=#f2c25a]letter[/color] and its [color=#f2c25a]Morse[/color] code.
 Blink to spell it: a [color=#f2c25a]short blink[/color] is a dot [font_size=14]●[/font_size], a [color=#f2c25a]long blink[/color] is a dash [font_size=22]—[/font_size]. Pause for a moment, and the letter is sent.
 Spell a creature's letter and a forest [color=#f2c25a]ally[/color] will sprout beside Lenny to fight it.
 Don't let creatures reach Lenny! He only has [color=#f2c25a]3 hearts[/color].
 Chain correct letters for a [color=#f2c25a]combo of up to ×5[/color]. Mistakes reset it.
 Every 10th creature defeated, a whole [color=#f2c25a]word[/color] marches in. Read it left to right![/ol]"
fit_content = true
scroll_active = false

[node name="Tip" type="Label" parent="Panel/Box" unique_id=1214400044]
layout_mode = 2
theme_type_variation = &"HintLabel"
theme_override_font_sizes/font_size = 14
text = "Remember to Calibrate first so the game learns your blinks.  
No camera? Turn on Keyboard Only in Settings and type . and -"
