[gd_scene format=3]

[ext_resource type="Script" path="res://GameUI/Screens/instructions.gd" id="1_script"]
[ext_resource type="Theme" path="res://GameUI/Screens/sos_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" uid="uid://cr6nelilg06km" path="res://Main Menu/Settings/SettingsMenu.png" id="3_stone"]
[ext_resource type="Texture2D" uid="uid://c7ccjdgauudfs" path="res://Main Menu/Background.png" id="4_bg"]
[ext_resource type="PackedScene" path="res://GameUI/Screens/wisteria_frame.tscn" id="5_wisteria"]
[ext_resource type="Script" uid="uid://d2nbxguos85jh" path="res://audio/scene_music.gd" id="6_music"]

[sub_resource type="StyleBoxTexture" id="StyleBoxTexture_stone"]
content_margin_left = 84.0
content_margin_top = 56.0
content_margin_right = 84.0
content_margin_bottom = 52.0
texture = ExtResource("3_stone")

[node name="Instructions" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("4_bg")
expand_mode = 1
stretch_mode = 6

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.03, 0.06, 0.16, 0.45)

[node name="Wisteria" parent="." instance=ExtResource("5_wisteria")]
layout_mode = 1

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(780, 630)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -390.0
offset_top = -315.0
offset_right = 390.0
offset_bottom = 315.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxTexture_stone")

[node name="Box" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="Panel/Box"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "How to Play"
horizontal_alignment = 1

[node name="Story" type="RichTextLabel" parent="Panel/Box"]
layout_mode = 2
mouse_filter = 2
bbcode_enabled = true
text = "[center][color=#f2c25a]TK[/color] is sending out an [color=#f2c25a]SOS[/color] in Morse code! Creatures are creeping through the forest toward Lenny. Answer the call and help [color=#f2c25a]Lenny survive[/color].[/center]"
fit_content = true
scroll_active = false

[node name="Rules" type="RichTextLabel" parent="Panel/Box"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/paragraph_separation = 4
theme_override_font_sizes/normal_font_size = 17
bbcode_enabled = true
text = "[ol type=1] Every creature carries a [color=#f2c25a]letter[/color] and its Morse code.
 Blink to spell it: a [color=#f2c25a]short blink[/color] is a dot [font_size=14]●[/font_size], a [color=#f2c25a]long blink[/color] is a dash [font_size=22]—[/font_size]. Pause and the letter is sent.
 Spell a creature's letter and a forest [color=#f2c25a]ally[/color] sprouts from Lenny to fight it.
 Don't let creatures reach Lenny. He only has [color=#f2c25a]3 hearts[/color].
 Chain correct letters for a [color=#f2c25a]combo up to ×5[/color]. Mistakes reset it.
 Every 10th creature defeated, a whole [color=#f2c25a]word[/color] marches in. Read it left to right![/ol]"
fit_content = true
scroll_active = false

[node name="Tip" type="Label" parent="Panel/Box"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Calibrate first so the game learns your blinks.  No camera? Turn on Keyboard only in Settings and type . and -"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Panel/Box"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Back" type="Button" parent="Panel/Box/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 70)
layout_mode = 2
text = "Back"

[node name="Play" type="Button" parent="Panel/Box/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 70)
layout_mode = 2
text = "Play"

[node name="Music" type="Node" parent="."]
script = ExtResource("6_music")
track = "main_menu"
